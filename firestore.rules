rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isConsoleAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/consoleUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/consoleUsers/$(request.auth.uid)).data.role in ['cto', 'administrator', 'manager'];
    }

    // --- Users & Console Users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isConsoleAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isConsoleAdmin();
      allow delete: if false;
    }

    match /consoleUsers/{userId} {
      allow read: if isOwner(userId) || isConsoleAdmin();
      allow write: if isConsoleAdmin();
    }

    // --- Address Submissions ---
    match /addressSubmissions/{submissionId} {
      // Submitter can read their own submission; console admins can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isConsoleAdmin();
      // Authenticated users can submit addresses
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Updates and approvals are reserved for console admins
      allow update, delete: if isConsoleAdmin();
    }

    // --- Gated Estates ---
    match /estates/{estateId} {
      // Verified estates are publicly readable (for checkouts, apps, and forms)
      allow read: if resource.data.status == 'verified' || isConsoleAdmin() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
      // Authenticated users can submit pending estates
      allow create: if isAuthenticated();
      // Verification and status updates restricted to console admins
      allow update, delete: if isConsoleAdmin();
    }

    // --- Nigerian Geography Hierarchy ---
    match /nigerianGeography/{stateId} {
      allow read: if true; // Public read for all applications and forms
      allow write: if isConsoleAdmin();

      match /lgas/{lgaId} {
        allow read: if true;
        allow write: if isConsoleAdmin();

        match /cities/{cityId} {
          allow read: if true;
          allow write: if isConsoleAdmin();
        }

        match /districts/{districtId} {
          allow read: if true;
          allow write: if isConsoleAdmin();
        }
      }
    }

    // --- Developer API Keys ---
    match /apiKeys/{keyId} {
      // User can view their own API keys; console admins can view all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isConsoleAdmin();
      // User can create keys for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // User can toggle active status of their own key, admin can manage any
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isConsoleAdmin();
      allow delete: if isConsoleAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
